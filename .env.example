# ==============================================================================
# Kwang-Lim Chapel Portal - Frontend Environment Configuration (.env.example)
# ==============================================================================

# Application Branding
VITE_APP_NAME="Africa University Kwang-Lim Chapel"
VITE_APP_ENV=local

# Port Configuration
# The port exposed on the host machine for Docker or local dev
FRONTEND_PORT=3000

# Backend API Endpoints
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api

# DOKPLOY / DOCKER DEPLOYMENT:
# In Dokploy, when both services are in the same docker network:
# BACKEND_URL=http://backend:80
# VITE_API_BASE_URL=/api
